# Unified Agentic Workflow API Keys
# ==================================
# ⚠️ WARNING: DO NOT put actual API keys in this file.
# Copy this file to .env and fill in your keys. The .env file is gitignored.
# See config.yaml for model assignments and usage.

# Anthropic API Key (Required for reasoning & editing models)
# Format: sk-ant-...
ANTHROPIC_API_KEY=""

# OpenAI API Key (Required for fallback models)
# Format: sk-proj-...
OPENAI_API_KEY=""

# OpenAI-compatible Provider (e.g., OpenRouter, DeepSeek, Local LLM)
# =============================================================
# COMPATIBLE_API_KEY: API key for your compatible provider
COMPATIBLE_API_KEY=""
# COMPATIBLE_BASE_URL: Base URL for the provider API
COMPATIBLE_BASE_URL=""
# COMPATIBLE_MODEL: Model name to use
COMPATIBLE_MODEL=""

# SonarCloud Configuration (Required for Quality Gate)
# ==================================================
# SONAR_TOKEN: Your SonarCloud analysis token
SONAR_TOKEN=""
# SONAR_PROJECT_KEY: The unique key of your project in SonarCloud
SONAR_PROJECT_KEY=""
# SONAR_ORGANIZATION: Your SonarCloud organization key
SONAR_ORGANIZATION=""
